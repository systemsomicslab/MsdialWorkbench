<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>

    <IsPackable>false</IsPackable>

    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>

    <Configurations>Debug;Release;Debug vendor unsupported;Release vendor unsupported</Configurations>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.4.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.9.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.9.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Common\CommonStandard\CommonStandard.csproj" />
    <ProjectReference Include="..\..\..\src\MSFINDER\MsfinderCommonStandard\MsfinderCommonStandard.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\Ini\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The engine's IL scanner and per-rule fixture spectra, shared with CommonStandardTests (design 6.1 items 3 and 5). -->
  <ItemGroup>
    <Compile Include="..\..\Common\CommonStandardTests\StructureFinder\DiagnosticRules\IlReferenceScanner.cs" Link="Linked\IlReferenceScanner.cs" />
    <None Include="..\..\Common\CommonStandardTests\Resources\DiagnosticRuleFixtures\rules\*.json" Link="Resources\DiagnosticRuleFixtures\rules\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
