<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="LipidSpectrumGeneratorTest_Cer.msp" />
    <None Remove="LipidSpectrumGeneratorTest_GL.msp" />
    <None Remove="LipidSpectrumGeneratorTest_GP.msp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Common\CommonStandard\CommonStandard.csproj" />
    <!-- Plain reference only (no OutputItemType=Analyzer): CommonStandard already runs the generator,
         this is just so ContextTests/FormulaSentenceParserTest/FormulaStringParserTests can see the
         generator's internal parsing classes via InternalsVisibleTo. -->
    <ProjectReference Include="..\..\..\src\Common\CompMs.Common.Lipidomics.SourceGenerator\CompMs.Common.Lipidomics.SourceGenerator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.9.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.9.3" />
    <PackageReference Include="coverlet.collector" Version="3.1.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="LipidSpectrumGeneratorTest_Cer.msp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="LipidSpectrumGeneratorTest_GL.msp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="LipidSpectrumGeneratorTest_GP.msp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="LipidSpectrumGeneratorTest_Others.msp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="LipidSpectrumGeneratorTest_ST.msp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
