<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>true</Optimize>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Common"><HintPath>$(LibraryAssemblyDirectory)/Common.dll</HintPath></Reference>
    <Reference Include="MsdialCore"><HintPath>$(LibraryAssemblyDirectory)/MsdialCore.dll</HintPath></Reference>
    <Reference Include="System.Memory" Condition="Exists('$(LibraryAssemblyDirectory)/System.Memory.dll')"><HintPath>$(LibraryAssemblyDirectory)/System.Memory.dll</HintPath></Reference>
    <Reference Include="System.Threading.Tasks.Extensions" Condition="Exists('$(LibraryAssemblyDirectory)/System.Threading.Tasks.Extensions.dll')"><HintPath>$(LibraryAssemblyDirectory)/System.Threading.Tasks.Extensions.dll</HintPath></Reference>
    <Reference Include="System.Runtime.CompilerServices.Unsafe" Condition="Exists('$(LibraryAssemblyDirectory)/System.Runtime.CompilerServices.Unsafe.dll')"><HintPath>$(LibraryAssemblyDirectory)/System.Runtime.CompilerServices.Unsafe.dll</HintPath></Reference>
    <Reference Include="System.Buffers" Condition="Exists('$(LibraryAssemblyDirectory)/System.Buffers.dll')"><HintPath>$(LibraryAssemblyDirectory)/System.Buffers.dll</HintPath></Reference>
    <Reference Include="MessagePack"><HintPath>$(LibraryAssemblyDirectory)/MessagePack.dll</HintPath></Reference>
    <Reference Include="MessagePack.Annotations" Condition="Exists('$(LibraryAssemblyDirectory)/MessagePack.Annotations.dll')"><HintPath>$(LibraryAssemblyDirectory)/MessagePack.Annotations.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireLibraryAssemblyDirectory" BeforeTargets="ResolveReferences" Condition="'$(LibraryAssemblyDirectory)' == ''">
    <Error Text="Set LibraryAssemblyDirectory to the version's net48 MsdialCore output directory." />
  </Target>
</Project>
