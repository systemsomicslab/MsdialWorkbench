<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true" />
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <probing privatePath="lib;lib\Shimadzu;lib\Bruker;lib\Sciex;lib\ThermoFisher;lib\Agilent;lib\Waters;lib\Reifycs;lib\Kanomax" />
      <!-- The ABF reader: RawDataHandler ships assembly RDAM_DLL as lib\Reifycs\RDAM.dll, which probing cannot find by name. -->
      <dependentAssembly>
        <assemblyIdentity name="RDAM_DLL" culture="neutral" />
        <codeBase version="1.7.0.4161" href="lib\Reifycs\RDAM.dll" />
      </dependentAssembly>
    </assemblyBinding>
    <!-- Server garbage collection for the .NET Framework build; ServerGarbageCollection in the project file covers .NET Core. -->
    <gcServer enabled="true" />
  </runtime>
</configuration>