<Window x:Class="CompMs.App.Msdial.View.Statistics.NotamePackageDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="700" Height="420" MinWidth="360" MinHeight="220"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox x:Name="DetailsTextBox"
                 AutomationProperties.Name="Package setup details"
                 IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
        <Button Grid.Row="1" Content="Close" MinWidth="80" Margin="0,12,0,0" Padding="12,4"
                HorizontalAlignment="Right" IsDefault="True" IsCancel="True" Click="Close_Click" />
    </Grid>
</Window>
