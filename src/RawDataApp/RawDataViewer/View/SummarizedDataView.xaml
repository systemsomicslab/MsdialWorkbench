<UserControl x:Class="CompMs.App.RawDataViewer.View.SummarizedDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:CompMs.App.RawDataViewer.ViewModel"
             xmlns:local="clr-namespace:CompMs.App.RawDataViewer.View"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type={x:Type vm:SummarizedDataViewModel}}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid.Resources>
            <!-- Each panel's DataContext is its PanelLoadResult: null while loading, then a view model or an error message. -->
            <Style TargetType="StackPanel" x:Key="LoadingIfNull">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Width" Value="160"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- Opaque, so that the empty chart of the failed panel does not show through the message. -->
            <Style TargetType="DockPanel" x:Key="ErrorIfFailed">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- A read-only TextBox rather than a TextBlock, so that the message can be selected and copied into a report. -->
            <Style TargetType="TextBox" x:Key="ErrorMessage">
                <Setter Property="Text" Value="{Binding ErrorMessage, Mode=OneWay}"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Margin" Value="16,4,16,16"/>
            </Style>
        </Grid.Resources>
        <Grid DataContext="{Binding MsSpectrumIntensityCheckPanel.Value}" Grid.Column="0" Grid.Row="0">
            <local:MsSpectrumIntensityCheckView DataContext="{Binding Value, FallbackValue={x:Null}}"/>
            <StackPanel Style="{StaticResource LoadingIfNull}">
                <TextBlock Text="Loading..."/>
                <ProgressBar IsIndeterminate="True"
                             Height="24"/>
            </StackPanel>
            <DockPanel Style="{StaticResource ErrorIfFailed}">
                <TextBlock Text="The spectrum intensity histograms could not be made:" DockPanel.Dock="Top" FontWeight="Bold" Margin="16,16,16,0"/>
                <TextBox Style="{StaticResource ErrorMessage}"/>
            </DockPanel>
        </Grid>
        <Grid DataContext="{Binding MsPeakSpotsCheckPanel.Value}"
              Grid.Column="1" Grid.Row="0">
            <local:MsPeakSpotsCheckView DataContext="{Binding Value, FallbackValue={x:Null}}"/>
            <StackPanel Style="{StaticResource LoadingIfNull}">
                <TextBlock Text="Loading..."/>
                <ProgressBar IsIndeterminate="True"
                             Height="24"/>
            </StackPanel>
            <DockPanel Style="{StaticResource ErrorIfFailed}">
                <TextBlock Text="The peak spots could not be detected:" DockPanel.Dock="Top" FontWeight="Bold" Margin="16,16,16,0"/>
                <TextBox Style="{StaticResource ErrorMessage}"/>
            </DockPanel>
        </Grid>
        <Grid DataContext="{Binding RawMsSpectrumCheckPanel.Value}"
              Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2">
            <local:RawMsSpectrumCheckView DataContext="{Binding Value, FallbackValue={x:Null}}"/>
            <StackPanel Style="{StaticResource LoadingIfNull}">
                <TextBlock Text="Loading..."/>
                <ProgressBar IsIndeterminate="True"
                             Height="24"/>
            </StackPanel>
            <DockPanel Style="{StaticResource ErrorIfFailed}">
                <TextBlock Text="The spectra could not be loaded:" DockPanel.Dock="Top" FontWeight="Bold" Margin="16,16,16,0"/>
                <TextBox Style="{StaticResource ErrorMessage}"/>
            </DockPanel>
        </Grid>
        <GridSplitter VerticalAlignment="Stretch"
                      HorizontalAlignment="Right"
                      Width="2"
                      Grid.Row="0" Grid.Column="0"/>
        <GridSplitter VerticalAlignment="Top"
                      HorizontalAlignment="Stretch"
                      Height="2"
                      Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"/>
    </Grid>
</UserControl>
