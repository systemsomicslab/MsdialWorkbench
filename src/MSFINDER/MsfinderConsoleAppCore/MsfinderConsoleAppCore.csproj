<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>netcoreapp3.1;net472</TargetFrameworks>
    <ApplicationIcon>msfinder_icon.ico</ApplicationIcon>
    <AssemblyName>MsfinderConsoleApp</AssemblyName>
    <Configurations>Debug;Release;Debug vendor unsupported;Release vendor unsupported</Configurations>
    <!-- Formula and structure prediction allocate heavily on all cores; the workstation collector stops every
         thread for each collection, the server collector does not. Results are unaffected. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MSDIAL4\ClassyfireApiStandard\ClassyfireApiStandard.csproj" />
    <ProjectReference Include="..\..\Common\CommonStandard\CommonStandard.csproj" />
    <ProjectReference Include="..\..\MSDIAL4\MolecularFormulaFinderStandard\MolecularFormulaFinderStandard.csproj" />
    <ProjectReference Include="..\MsfinderCommonStandard\MsfinderCommonStandard.csproj" />
    <ProjectReference Include="..\..\MSDIAL4\PugRestApiStandard\PugRestApiStandard.csproj" />
    <ProjectReference Include="..\..\MSDIAL4\StructureFinderStandard\StructureFinderStandard.csproj" />
  </ItemGroup>

</Project>
